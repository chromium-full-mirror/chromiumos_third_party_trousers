[Unit]
Description=TrouSerS daemon
PartOf=boot-services.target
After=boot-services.target tpm-probe.service

[Service]
Restart=always
Type=forking
ExecStartPre=/bin/sh /usr/share/cros/init/tcsd-pre-start.sh
ExecStart=/usr/sbin/tcsd
ExecStopPost=-/bin/sh -c "tpmc savestate || \
	logger -t %n \"final tpmc savestate: $?\""
